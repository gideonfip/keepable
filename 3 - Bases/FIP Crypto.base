filters:
  and:
    - file.inFolder("2 - Source Materials/FIP Crypto")
formulas:
  Source: if(file.properties.source, file.properties.source, "")
  WordCount: if(file.properties.wordCount, file.properties.wordCount, 0)
  Author: if(file.properties.author, file.properties.author, "")
properties:
  formula.Source:
    displayName: Source
  formula.WordCount:
    displayName: Word Count
  formula.Author:
    displayName: Author
views:
  - type: table
    name: All FIP Crypto Articles
    order:
      - file.name
      - published
      - wordCount
      - formula.Source
      - tags
    sort:
      - property: published
        direction: DESC
    columnSize:
      file.name: 400
      published: 120
      wordCount: 80
      description: 300
      formula.Source: 250
      tags: 150
