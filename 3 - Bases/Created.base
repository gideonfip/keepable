name: Created
description: All personally created content across FIP Crypto, gideonfip, and nuhgid accounts
filters:
  or:
    - file.inFolder("2 - Source Materials/FIP Crypto")
    - file.inFolder("2 - Source Materials/gideonfip")
    - file.inFolder("2 - Source Materials/nuhgid")
formulas:
  Source: if(file.properties.source, file.properties.source, "")
  Account: if(file.inFolder("2 - Source Materials/FIP Crypto"), "FIP Crypto", if(file.inFolder("2 - Source Materials/gideonfip"), "gideonfip", if(file.inFolder("2 - Source Materials/nuhgid"), "nuhgid", "")))
properties:
  formula.Source:
    displayName: Source
  formula.Account:
    displayName: Account
views:
  - type: table
    name: All Created
    order:
      - file.name
      - published
      - formula.Account
      - description
      - formula.Source
      - tags
    sort:
      - property: published
        direction: DESC
    columnSize:
      file.name: 400
      published: 120
      formula.Account: 120
      description: 300
      formula.Source: 250
      tags: 150
  - type: table
    name: By Account
    order:
      - formula.Account
      - file.name
      - published
      - description
    sort:
      - property: formula.Account
        direction: ASC
      - property: published
        direction: DESC
    columnSize:
      formula.Account: 120
      file.name: 400
      published: 120
      description: 300
  - type: cards
    name: Card View
    order:
      - file.name
      - published
      - formula.Account
    sort:
      - property: published
        direction: DESC
