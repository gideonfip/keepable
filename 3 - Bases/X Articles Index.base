filters:
  and:
    - file.inFolder("2 - Source Materials/X Articles")
formulas:
  Author: if(file.properties.author, file.properties.author, "")
  Source: if(file.properties.source, file.properties.source, "")
properties:
  formula.Author:
    displayName: Author
  formula.Source:
    displayName: Source
views:
  - type: table
    name: All Articles
    order:
      - file.name
      - formula.Author
      - published
      - formula.Source
      - type
      - tags
    sort:
      - property: published
        direction: DESC
    columnSize:
      file.name: 400
      published: 120
      note.type: 100
      note.tags: 150
      formula.Author: 150
      formula.Source: 250
